#!/bin/sh
# Auto-restore file identitas app (applicationId/bundle id/signing/Firebase client config)
# di branch main/Main setiap ada commit baru (merge, cherry-pick, atau commit langsung)
# yang mengubahnya. Tujuannya: main selalu pakai identity-nya sendiri, gak ketiban
# perubahan appId/dsb dari branch lain lewat merge/cherry-pick.
#
# Setup sekali per clone: git config core.hooksPath .githooks
#
# Bypass sengaja (kalau memang mau ubah identity di main): tambahkan tag [allow-identity]
# di commit message.

# Guard anti-rekursi: script ini bikin commit --amend, yang juga memicu post-commit lagi.
if [ -n "$_IDENTITY_HOOK_RUNNING" ]; then
    exit 0
fi

branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
case "$branch" in
    main|Main) ;;
    *) exit 0 ;;
esac

msg=$(git log -1 --format=%B HEAD 2>/dev/null)
case "$msg" in
    *"[allow-identity]"*) exit 0 ;;
esac

prev=$(git rev-parse "HEAD@{1}" 2>/dev/null) || exit 0

protected="android/app/build.gradle.kts android/app/google-services.json ios/Runner/GoogleService-Info.plist firebase.json lib/firebase_options.dart"

restored=""
for f in $protected; do
    if git cat-file -e "$prev:$f" 2>/dev/null; then
        if ! git diff --quiet "$prev" HEAD -- "$f" 2>/dev/null; then
            git checkout "$prev" -- "$f"
            restored="$restored $f"
        fi
    fi
done

if [ -n "$restored" ]; then
    _IDENTITY_HOOK_RUNNING=1 git commit --amend --no-edit --no-verify -q
    echo "[post-commit] Restored identity file(s) on '$branch' to previous content:$restored"
    echo "[post-commit] Kalau perubahan ini memang disengaja, commit ulang dengan tag [allow-identity] di message."
fi
